generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantLeadStatus {
  PENDING
  CONVERTED
  DELETED
}

enum EmploymentStatus {
  ACTIVE
  ON_PROBATION
  INACTIVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PROCESSING
  COMPLETED
}

enum PayslipStatus {
  GENERATED
  SENT
}

enum JobPostStatus {
  DRAFT
  OPEN
  CLOSED
}

enum PipelineStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus  @default(ACTIVE)
  tenantId     Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tenant       Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  roles        UserRole[]
  employee     Employee?
  invitations  Invitation[]
  passwordResetTokens PasswordResetToken[]
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @map("role")
  tenantId        Int?             @map("tenant_id")
  description     String?
  createdDate     DateTime         @default(now()) @map("created_date")
  updatedDate     DateTime         @updatedAt @map("updated_date")
  createdBy       Int?             @map("created_by")
  updatedBy       Int?             @map("updated_by")
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  users           UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  roleId      Int      @map("role_id")
  createdDate DateTime @default(now()) @map("created_date")
  updatedDate DateTime @updatedAt @map("updated_date")
  createdBy   Int?     @map("created_by")
  updatedBy   Int?     @map("updated_by")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_role")
}

model Permission {
  id              Int              @id @default(autoincrement())
  permission      String           @unique
  module          String
  description     String?
  createdDate     DateTime         @default(now()) @map("created_date")
  updatedDate     DateTime         @updatedAt @map("updated_date")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdDate  DateTime   @default(now()) @map("created_date")
  createdBy    Int?       @map("created_by")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("roles_permission")
}

model Tenant {
  id             Int            @id @default(autoincrement())
  name           String
  companyCode    String?        @unique
  plan           String
  config         Json?
  status         TenantStatus   @default(ACTIVE)
  leadStatus     TenantLeadStatus @default(PENDING)
  seats          Int            @default(5)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          User[]
  roles          Role[]
  employees      Employee[]
  payrollRuns    PayrollRun[]
  candidates     Candidate[]
  jobPosts       JobPost[]
  invitations    Invitation[]
  departments    Department[]
  teams          Team[]
  locations      Location[]
  leavePolicies  LeavePolicy[]
  leaveBalances  LeaveBalance[]
  billingSettings TenantBillingSettings?
  billingDispatchLogs BillingReminderDispatch[]
  moduleSettings TenantModuleSetting[]
  fieldSettings  TenantFieldSetting[]
  attendanceSettings AttendanceSettings?
  workShifts         WorkShift[]
  companyHolidays    CompanyHoliday[]
  canteenSettings CanteenSettings?
  canteenMealEntries CanteenMealEntry[]
  hrLetters      HrLetter[]
  hrFeedback     HrFeedback[]
}

model ModuleDefinition {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  label       String
  description String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  fields      FieldDefinition[]

  @@map("module_definitions")
}

model FieldDefinition {
  id        Int              @id @default(autoincrement())
  moduleKey String
  fieldKey  String
  label     String
  fieldType String
  options   Json?
  isSystem  Boolean          @default(false)
  isActive  Boolean          @default(true)
  module    ModuleDefinition @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@unique([moduleKey, fieldKey])
  @@map("field_definitions")
}

model TenantModuleSetting {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  moduleKey String
  enabled   Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_module_settings")
}

model TenantFieldSetting {
  id        Int     @id @default(autoincrement())
  tenantId  Int
  moduleKey String
  fieldKey  String
  enabled   Boolean @default(true)
  required  Boolean @default(false)
  sortOrder Int     @default(0)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleKey, fieldKey])
  @@index([tenantId, moduleKey])
  @@map("tenant_field_settings")
}

model TenantBillingSettings {
  id                    Int      @id @default(autoincrement())
  tenantId              Int      @unique
  enabled               Boolean  @default(true)
  reminderDaysCsv       String   @default("7,3,1,0")
  recipientEmailsCsv    String?
  subjectTemplate       String?
  bodyTemplate          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_billing_settings")
}

model BillingReminderDispatch {
  id             Int      @id @default(autoincrement())
  tenantId       Int
  reminderType   String
  reminderKey    String
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, reminderKey])
  @@index([sentAt])
  @@map("billing_reminder_dispatch")
}

model PlatformSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model Invitation {
  id         Int              @id @default(autoincrement())
  tenantId   Int
  userId     Int
  email      String
  role       String
  status     InvitationStatus @default(PENDING)
  tokenHash  String           @unique
  invitedAt  DateTime         @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([tenantId, status])
}

model Employee {
  id               Int              @id @default(autoincrement())
  tenantId         Int
  userId           Int              @unique
  employeeCode     String           @unique
  department       String
  designation      String
  joinedDate       DateTime
  dateOfBirth      DateTime?
  salary           Float            @default(0)
  employmentStatus EmploymentStatus @default(ACTIVE)
  deletedAt        DateTime?
  offboardingReason String?
  offboardedAt     DateTime?
  departmentId     Int?
  teamId           Int?
  locationId       Int?
  managerId        Int?
  customFields     Json             @default("{}")
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentRelation Department?    @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  team             Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  location         Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager          Employee?        @relation("EmployeeToManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]       @relation("EmployeeToManager")
  managedDepartments Department[]   @relation("DepartmentManager")
  shiftId          Int?
  shift            WorkShift?       @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  leaveRequests    LeaveRequest[]
  approvedLeaves   LeaveRequest[]   @relation("ApprovedLeaves")
  attendance       Attendance[]
  payslips         Payslip[]
  leaveBalances    LeaveBalance[]
  canteenMealEntries CanteenMealEntry[]
}

model AttendanceSettings {
  id                           Int      @id @default(autoincrement())
  tenantId                     Int      @unique
  scheduleMode                 String   @default("FIXED")
  workStartTime                String   @default("09:00")
  workEndTime                  String   @default("17:00")
  lateArrivalGraceMinutes      Int      @default(0)
  lateArrivalAction            String   @default("FLAG")
  lateArrivalRepeatedThreshold Int      @default(3)
  lateArrivalEscalationAction  String   @default("WARN")
  earlyDepartureGraceMinutes   Int      @default(0)
  earlyDepartureAction         String   @default("FLAG")
  weekendDays                  Json     @default("[6,0]")
  /// Weekday numbers (0=Sun..6=Sat) that are half working days (e.g. Saturday half-day). Must not overlap weekendDays.
  halfWorkingDays              Json     @default("[]")
  /// Scheduled end time used on half working days (e.g. 13:00).
  halfDayEndTime               String   @default("13:00")
  overtimeEnabled              Boolean  @default(false)
  overtimeRules                Json     @default("{}")
  missingClockInAction         String   @default("FLAG")
  missingClockOutAction        String   @default("FLAG")
  missingBothAction            String   @default("ABSENT")
  autoAbsentEnabled            Boolean  @default(true)
  requireManagerApproval       Boolean  @default(false)
  payrollIntegration           Json     @default("{}")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  tenant                       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("attendance_settings")
}

model WorkShift {
  id                   Int        @id @default(autoincrement())
  tenantId             Int
  name                 String
  startTime            String
  endTime              String
  breakMinutes         Int        @default(0)
  isNightShift         Boolean    @default(false)
  isDefault            Boolean    @default(false)
  isActive             Boolean    @default(true)
  overtimeEligible     Boolean    @default(true)
  flexibleGraceMinutes Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees            Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("work_shifts")
}

model CompanyHoliday {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  name        String
  date        DateTime
  isRecurring Boolean  @default(false)
  isPaid      Boolean  @default(true)
  /// When true, employees still work a half day (counts 0.5 toward leave if leave is taken).
  isHalfDay   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("company_holidays")
}

model CanteenSettings {
  id                       Int      @id @default(autoincrement())
  tenantId                 Int      @unique
  enabled                  Boolean  @default(true)
  defaultMealCost          Float    @default(0)
  salaryDeduct             Boolean  @default(false)
  autoAssignFromAttendance Boolean  @default(false)
  mealTypes                Json     @default("[]")
  defaultMealCounts        Json     @default("{}")
  notes                    String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  tenant                   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("canteen_settings")
}

model CanteenMealEntry {
  id               Int      @id @default(autoincrement())
  tenantId         Int
  employeeId       Int
  date             DateTime
  mealCount        Int      @default(1)
  mealCost         Float    @default(0)
  mealBreakdown    Json?
  totalCost        Float    @default(0)
  deductFromSalary Boolean  @default(false)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@map("canteen_meal_entries")
}

model LeaveRequest {
  id               Int         @id @default(autoincrement())
  employeeId       Int
  type             String
  startDate        DateTime
  endDate          DateTime
  days             Float
  /// Portion of `days` covered by leave balance (salary not deducted).
  paidDays         Float       @default(0)
  /// Portion beyond entitlement — deducted from salary on payroll with reason.
  unpaidDays       Float       @default(0)
  reason           String
  status           LeaveStatus @default(PENDING)
  approvalComment  String?
  rejectionReason  String?
  createdAt        DateTime    @default(now())
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedById     Int?
  approvedBy       Employee?   @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)
}

model Attendance {
  id                    Int      @id @default(autoincrement())
  employeeId            Int
  date                  DateTime
  clockIn               DateTime?
  clockOut              DateTime?
  hours                 Float    @default(0)
  status                String
  lateMinutes           Int      @default(0)
  earlyDepartureMinutes Int      @default(0)
  overtimeHours         Float    @default(0)
  payrollAdjustment     Float    @default(0)
  source                String   @default("CLOCK")
  notes                 String?
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
}

model PayrollRun {
  id          Int           @id @default(autoincrement())
  tenantId    Int
  period      String
  grossAmount Float
  netAmount   Float
  status      PayrollStatus @default(DRAFT)
  processedAt DateTime?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips    Payslip[]
}

model Payslip {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  payrollRunId Int
  basicPay     Float         @default(0)
  allowances   Float         @default(0)
  attendanceDeduction Float  @default(0)
  leaveDeduction      Float  @default(0)
  /// Line-item reasons for deductions shown on payslip UI/PDF.
  deductionBreakdown  Json   @default("[]")
  grossPay     Float
  epfEmployee  Float         @default(0)
  epfEmployer  Float         @default(0)
  etfEmployer  Float         @default(0)
  payeTax      Float         @default(0)
  deductions   Float
  netPay       Float
  status       PayslipStatus @default(GENERATED)
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
}

model JobPost {
  id             Int           @id @default(autoincrement())
  tenantId       Int
  title          String
  department     String?
  description    String?
  requiredSkills String[]      @default([])
  status         JobPostStatus @default(DRAFT)
  openedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidates     Candidate[]
}

model Candidate {
  id             Int           @id @default(autoincrement())
  tenantId       Int
  jobPostId      Int?
  name           String
  email          String
  phone          String?
  roleApplied    String
  source         String
  stage          PipelineStage @default(APPLIED)
  rating         Int           @default(0)
  resumeUrl      String?
  resumeFileName String?
  notes          String?
  appliedAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPost        JobPost?      @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
}

model Location {
  id          Int          @id @default(autoincrement())
  tenantId    Int
  name        String
  address     String?
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments Department[]
  employees   Employee[]
}

model Department {
  id          Int        @id @default(autoincrement())
  tenantId    Int
  name        String
  managerId   Int?
  locationId  Int?
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  manager     Employee?  @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams       Team[]
  employees   Employee[] @relation("EmployeeDepartment")
}

model Team {
  id           Int        @id @default(autoincrement())
  tenantId     Int
  departmentId Int
  name         String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  employees    Employee[]
}

model LeavePolicy {
  id                Int            @id @default(autoincrement())
  tenantId          Int
  code              String?
  name              String
  days              Float
  carryForwardLimit Float          @default(0)
  accrualRate       Float          @default(0)
  sortOrder         Int            @default(0)
  isActive          Boolean        @default(true)
  description       String?
  genderScope       String         @default("ALL")
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaveBalances     LeaveBalance[]

  @@unique([tenantId, code])
}

model LeaveBalance {
  id            Int         @id @default(autoincrement())
  tenantId      Int
  employeeId    Int
  leavePolicyId Int
  allocated     Float
  used          Float       @default(0)
  accrued       Float       @default(0)
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leavePolicy   LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leavePolicyId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model HrLetter {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  title         String
  letterType    String   @default("GENERAL")
  recipientName String?
  body          String
  status        String   @default("DRAFT")
  createdBy     Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("hr_letters")
}

model HrFeedback {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  authorUserId  Int
  subjectLabel  String?
  category      String   @default("GENERAL")
  rating        Int?
  body          String
  contextModule String?
  createdAt     DateTime @default(now())
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("hr_feedback")
}
