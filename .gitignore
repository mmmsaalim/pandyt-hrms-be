# --- Dependencies & build output ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# --- Secrets: never commit real credentials ---
# .env.example IS committed (it documents required keys without real values).
.env
.env.*
!.env.example

# --- Runtime / uploads ---
uploads/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Local throwaway scripts (one-off migrations / DB checks) ---
prisma/_tmp-*.ts

# --- Editor / OS noise ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
